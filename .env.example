# Development credentials only; replace before deployment.
DATABASE_PASSWORD=change-this-database-password
DATABASE_ROOT_PASSWORD=change-this-root-password
WORKER_CONCURRENCY=2
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:3000
# Set true behind HTTPS in deployment; false is for localhost HTTP only.
COOKIE_SECURE=false

# History retention (all replicas must use the same policy).
RETENTION_ENABLED=true
RETENTION_CHECK_HOURS=24
RETENTION_SUMMARY_DAYS=90
RETENTION_EVENT_DAYS=30
RETENTION_INCIDENT_DAYS=90
RETENTION_DELIVERY_DAYS=30
RETENTION_AUDIT_DAYS=90
RETENTION_BATCH_SIZE=250
RETENTION_INTERVAL_SECONDS=60

# Separate private metrics listener on port 3002; no host port is published.
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1

# Optional first-admin browser setup, only while no accounts exist.
# Set a random 32–256 character token, then remove it after setup.
SETUP_TOKEN=

{
  "name": "dnsmonitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "check": "pnpm typecheck && pnpm test",
    "query": "node dist/apps/cli/src/main.js",
    "worker": "node dist/apps/worker/src/main.js",
    "db": "node dist/apps/cli/src/database.js",
    "test:integration": "pnpm build && node --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "start": "node dist/apps/api/src/main.js",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@node-rs/argon2": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dns-packet": "^5.6.1",
    "fastify": "^5.12.4",
    "lucide-react": "^0.468.0",
    "mariadb": "^3.5.0",
    "nodemailer": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "smtp-server": "^3.19.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "version": "0.1.0",
  "license": "MIT"
}
